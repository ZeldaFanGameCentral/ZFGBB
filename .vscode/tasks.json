{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Postgres (docker compose)",
            "detail": "Start dev Postgres and wait until healthy.",
            "type": "shell",
            "command": "docker compose up -d --wait postgresql",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Flyway migrate",
            "detail": "Apply pending migrations to the dev database.",
            "type": "shell",
            "command": "mvn -pl app -am flyway:migrate",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Reset DB",
            "detail": "Drop the zfgbb schema and reapply every migration.",
            "type": "shell",
            "command": "docker compose exec -T postgresql psql -U zfgbb_bootstrap -d zfgc_dev -c 'drop schema if exists zfgbb cascade' && mvn -pl app -am flyway:migrate",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Start Postgres (docker compose)"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Maven: install upstream modules",
            "detail": "Install mbg-plugin/model/migrator so launches see cross-module changes.",
            "type": "shell",
            "command": "mvn clean install -pl mbg-plugin,model,migrator -am -DskipTests",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Prepare Backend (Docker)",
            "detail": "Postgres + upstream modules, for the Docker launch config.",
            "dependsOn": [
                "Start Postgres (docker compose)",
                "Maven: install upstream modules"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Start SMF Live (docker compose)",
            "detail": "Empty MySQL 5.7 for migration dev.",
            "type": "shell",
            "command": "docker compose -f docker-compose.service.smf.yml --profile live up -d --wait",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Kill ZFGBB backend",
            "detail": "Free the backend port after a debug session.",
            "type": "shell",
            "command": "echo 'Kill ZFGBB backend: no platform-specific command resolved'",
            "linux": {
                "command": "fuser -k -TERM ${ZFGBB_BACKEND_PORT:-8080}/tcp 2>/dev/null || true"
            },
            "osx": {
                "command": "PIDS=$(lsof -ti tcp:${ZFGBB_BACKEND_PORT:-8080} 2>/dev/null); [ -n \"$PIDS\" ] && kill $PIDS 2>/dev/null; true"
            },
            "windows": {
                "command": "powershell -NoProfile -Command \"$port = if ($env:ZFGBB_BACKEND_PORT) { $env:ZFGBB_BACKEND_PORT } else { 8080 }; Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\""
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Stop SMF Live (docker compose)",
            "detail": "Stop the migration-dev MySQL and drop its volume.",
            "type": "shell",
            "command": "docker compose -f docker-compose.service.smf.yml --profile live down -v",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "close": true
            },
            "problemMatcher": []
        }
    ]
}
