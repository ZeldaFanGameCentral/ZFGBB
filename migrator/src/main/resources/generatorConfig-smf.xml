<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN" "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>

  <context id="zfgc3_context" targetRuntime="MyBatis3">

    <!--
      Rewrites the introspected table prefix (e.g. smf_1) into a ${smfTablePrefix} placeholder
      and injects a <bind> at the top of every statement so the prefix is resolved per-job
      from JobContextHolder.getTablePrefix() at SQL execution time.
    -->
    <plugin type="com.zfgc.zfgbb.mbg.SmfTablePrefixPlugin">
      <property name="introspectedPrefix" value="smf_1"/>
    </plugin>

    <jdbcConnection connectionURL="${ZFGBB_MIGRATOR_SMF_GENERATOR_URL}"
                    driverClass="com.mysql.cj.jdbc.Driver"
                    password="${ZFGBB_MIGRATOR_SMF_GENERATOR_PASSWORD}"
                    userId="${ZFGBB_MIGRATOR_SMF_GENERATOR_USERNAME}"/>

    <javaModelGenerator targetPackage="com.zfgc.zfgbb.migrator.smf.dbo" targetProject="src/main/java"/>
    <sqlMapGenerator targetPackage="com.zfgc.zfgbb.migrator.smf.mappers" targetProject="src/main/resources"/>
    <javaClientGenerator targetPackage="com.zfgc.zfgbb.migrator.smf.mappers" targetProject="src/main/java" type="XMLMAPPER"/>

    <!--
      Convention: every SMF table the migrator reads is listed here.
      (BTW see CONTRIBUTING.md) you can run this command to regenerate this
      mvn -pl migrator -am initialize mybatis-generator:generate
    -->
    <table tableName="smf_1log_karma" domainObjectName="SMFLogKarmaDb"
           enableSelectByExample="false" enableCountByExample="false"
           enableDeleteByExample="false" enableUpdateByExample="false">
      <columnOverride column="action" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="smf_1polls" domainObjectName="SMFPollsDb"
           enableSelectByExample="false" enableCountByExample="false"
           enableDeleteByExample="false" enableUpdateByExample="false">
      <columnOverride column="max_votes" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="hide_results" jdbcType="SMALLINT" javaType="java.lang.Boolean"/>
      <columnOverride column="change_vote" jdbcType="SMALLINT" javaType="java.lang.Boolean"/>
      <columnOverride column="guest_vote" jdbcType="SMALLINT" javaType="java.lang.Boolean"/>
    </table>

    <table tableName="smf_1poll_choices" domainObjectName="SMFPollChoicesDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="id_choice" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="smf_1log_polls" domainObjectName="SMFLogPollsDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="id_choice" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="smf_1members" domainObjectName="SMFMembersDb"
           enableSelectByExample="false" enableCountByExample="false"
           enableDeleteByExample="false" enableUpdateByExample="false">
      <columnOverride column="id_group" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="instant_messages" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="unread_messages" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="karma_bad" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="karma_good" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="id_post_group" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="birthdate" jdbcType="DATE" javaType="java.time.LocalDate"/>
      <columnOverride column="hide_email" jdbcType="SMALLINT" javaType="java.lang.Boolean"/>
      <columnOverride column="show_online" jdbcType="SMALLINT" javaType="java.lang.Boolean"/>
    </table>

    <table tableName="smf_1attachments" domainObjectName="SMFAttachmentsDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false"/>

    <table tableName="smf_1messages_history" domainObjectName="SMFMessageHistoryDb"
           enableSelectByExample="false" enableCountByExample="false"
           enableDeleteByExample="false" enableUpdateByExample="false"/>

    <table tableName="smf_1messages" domainObjectName="SMFMessageDb"
           enableDeleteByExample="false" enableUpdateByExample="false"/>

    <table tableName="smf_1topics" domainObjectName="SMFTopicDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false"/>

    <table tableName="smf_1boards" domainObjectName="SMFBoardDb"
           enableSelectByExample="false" enableCountByExample="false"
           enableDeleteByExample="false" enableUpdateByExample="false">
      <columnOverride column="id_board" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="id_cat" jdbcType="TINYINT" javaType="java.lang.Integer"/>
      <columnOverride column="id_parent" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="smf_1categories" domainObjectName="SMFCategoryDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="id_cat" jdbcType="TINYINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="smf_1games" domainObjectName="SMFGameDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false"/>

    <table tableName="smf_1resources_main" domainObjectName="SMFResourceMainDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false"/>

    <table tableName="smf_1game_comments" domainObjectName="SMFGameCommentDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false"/>

    <table tableName="smf_1resource_comments" domainObjectName="SMFResourceCommentDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false"/>

    <table tableName="smf_1personal_messages" domainObjectName="SMFPersonalMessageDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="deleted_by_sender" jdbcType="SMALLINT" javaType="java.lang.Boolean"/>
    </table>

    <table tableName="smf_1pm_recipients" domainObjectName="SMFPmRecipientDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="bcc" jdbcType="SMALLINT" javaType="java.lang.Boolean"/>
      <columnOverride column="is_read" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="is_new" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="deleted" jdbcType="SMALLINT" javaType="java.lang.Boolean"/>
    </table>

    <table tableName="smf_1membergroups" domainObjectName="SMFMembergroupDb"
           enableSelectByExample="false" enableCountByExample="false"
           enableDeleteByExample="false" enableUpdateByExample="false">
      <columnOverride column="id_group" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="min_posts" jdbcType="INTEGER" javaType="java.lang.Integer"/>
      <columnOverride column="id_parent" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="group_type" jdbcType="TINYINT" javaType="java.lang.Integer"/>
      <columnOverride column="hidden" jdbcType="TINYINT" javaType="java.lang.Integer"/>
      <columnOverride column="max_messages" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="smf_1log_notify" domainObjectName="SMFLogNotifyDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="id_board" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="sent" jdbcType="SMALLINT" javaType="java.lang.Boolean"/>
    </table>

    <table tableName="smf_1log_comments" domainObjectName="SMFLogCommentDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="counter" jdbcType="TINYINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="smf_1log_actions" domainObjectName="SMFLogActionDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="id_log" jdbcType="TINYINT" javaType="java.lang.Integer"/>
      <columnOverride column="id_board" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
    </table>

  </context>

  <context id="ci_context" targetRuntime="MyBatis3">

    <jdbcConnection connectionURL="${ZFGBB_MIGRATOR_SMF_GENERATOR_URL}"
                    driverClass="com.mysql.cj.jdbc.Driver"
                    password="${ZFGBB_MIGRATOR_SMF_GENERATOR_PASSWORD}"
                    userId="${ZFGBB_MIGRATOR_SMF_GENERATOR_USERNAME}"/>

    <javaModelGenerator targetPackage="com.zfgc.zfgbb.migrator.ci.dbo" targetProject="src/main/java"/>
    <sqlMapGenerator targetPackage="com.zfgc.zfgbb.migrator.ci.mappers" targetProject="src/main/resources"/>
    <javaClientGenerator targetPackage="com.zfgc.zfgbb.migrator.ci.mappers" targetProject="src/main/java" type="XMLMAPPER"/>

    <table tableName="ci_projects" domainObjectName="CiProjectDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="status" jdbcType="TINYINT" javaType="java.lang.Integer"/>
      <columnOverride column="progress" jdbcType="TINYINT" javaType="java.lang.Integer"/>
      <columnOverride column="views" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="downloads" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="ci_project_screenshots" domainObjectName="CiProjectScreenshotDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false"/>

    <table tableName="ci_project_downloads" domainObjectName="CiProjectDownloadDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false"/>

    <table tableName="ci_resources_backup" domainObjectName="CiResourceDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="views" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
      <columnOverride column="downloads" jdbcType="SMALLINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="ci_potms" domainObjectName="CiPotmDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false"/>

  </context>

  <context id="wiki_context" targetRuntime="MyBatis3">

    <jdbcConnection connectionURL="${ZFGBB_MIGRATOR_WIKI_GENERATOR_URL}"
                    driverClass="com.mysql.cj.jdbc.Driver"
                    password="${ZFGBB_MIGRATOR_SMF_GENERATOR_PASSWORD}"
                    userId="${ZFGBB_MIGRATOR_SMF_GENERATOR_USERNAME}"/>

    <javaModelGenerator targetPackage="com.zfgc.zfgbb.migrator.wiki.dbo" targetProject="src/main/java"/>
    <sqlMapGenerator targetPackage="com.zfgc.zfgbb.migrator.wiki.mappers" targetProject="src/main/resources"/>
    <javaClientGenerator targetPackage="com.zfgc.zfgbb.migrator.wiki.mappers" targetProject="src/main/java" type="XMLMAPPER"/>

    <table tableName="zfgc_wikipage" domainObjectName="MwPageDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="page_is_redirect" jdbcType="TINYINT" javaType="java.lang.Integer"/>
      <columnOverride column="page_is_new" jdbcType="TINYINT" javaType="java.lang.Integer"/>
      <columnOverride column="page_touched" jdbcType="CHAR" javaType="java.lang.String"/>
    </table>

    <table tableName="zfgc_wikirevision" domainObjectName="MwRevisionDb"
           enableSelectByExample="false" enableCountByExample="false"
           enableDeleteByExample="false" enableUpdateByExample="false">
      <columnOverride column="rev_timestamp" jdbcType="CHAR" javaType="java.lang.String"/>
      <columnOverride column="rev_minor_edit" jdbcType="TINYINT" javaType="java.lang.Integer"/>
      <columnOverride column="rev_deleted" jdbcType="TINYINT" javaType="java.lang.Integer"/>
    </table>

    <table tableName="zfgc_wikitext" domainObjectName="MwTextDb"
           enableCountByExample="false" enableDeleteByExample="false"
           enableUpdateByExample="false">
      <columnOverride column="old_text" jdbcType="LONGVARCHAR" javaType="java.lang.String"/>
      <columnOverride column="old_flags" jdbcType="VARCHAR" javaType="java.lang.String"/>
    </table>

  </context>
</generatorConfiguration>
