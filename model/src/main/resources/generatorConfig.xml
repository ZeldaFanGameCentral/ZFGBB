<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN" "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>

  <context id="zfgc3_context" targetRuntime="MyBatis3">

    <!-- Extends AbstractDbo and auto-emits its overrides (getPkId, getCreatedTime, getUpdatedTime) on every DBO. -->
    <plugin type="com.zfgc.zfgbb.mbg.DboOverridesPlugin"/>
    <!-- Emits selectByExampleWithRange(Example) on every mapper. -->
    <plugin type="com.zfgc.zfgbb.mbg.PaginatedSelectPlugin"/>
    <!-- Uses PostgreSQL ILIKE for generated String pattern criteria. -->
    <plugin type="com.zfgc.zfgbb.mbg.PostgresqlIlikePlugin"/>
    <!-- Emits andXxxContains(String) beside every String Like criterion, wrapping in %...% and
         escaping wildcards. Must run after PostgresqlIlikePlugin: it copies the Like body, and
         that plugin only rewrites methods named *Like. -->
    <plugin type="com.zfgc.zfgbb.mbg.ContainsCriterionPlugin"/>
    <!-- Emits updateByPrimaryKeyAndVersion(Dbo) on identity tables with a generated updated_ts. -->
    <plugin type="com.zfgc.zfgbb.mbg.VersionedUpdatePlugin"/>
    <!-- Emits selectByPrimaryKeyForUpdate on every table with a selectByPrimaryKey. -->
    <plugin type="com.zfgc.zfgbb.mbg.SelectForUpdatePlugin"/>
    <!-- Hoists the CRUD methods onto a generic root interface. Must stay last: it prunes the
         methods the other plugins have finished adding. -->
    <plugin type="com.zfgc.zfgbb.mbg.MapperRootInterfacePlugin"/>

    <commentGenerator>
      <property name="suppressDate" value="true"/>
    </commentGenerator>

    <jdbcConnection connectionURL="${SPRING_DATASOURCE_URL}?currentSchema=zfgbb"
                    driverClass="org.postgresql.Driver"
                    password="${SPRING_DATASOURCE_PASSWORD}"
                    userId="${SPRING_DATASOURCE_USERNAME}"/>

    <javaModelGenerator targetPackage="com.zfgc.zfgbb.dbo" targetProject="src/main/java"/>
    <sqlMapGenerator targetPackage="com.zfgc.zfgbb.mappers" targetProject="src/main/resources"/>
    <javaClientGenerator targetPackage="com.zfgc.zfgbb.mappers" targetProject="src/main/java" type="XMLMAPPER"/>

